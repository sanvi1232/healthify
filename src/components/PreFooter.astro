---
import { MessageCircle } from "lucide-astro";

const whatsappNumber = "918892550840"; // Placeholder: Replace with actual business number
const whatsappLink = `https://wa.me/${whatsappNumber}?text=Hi! I'd like to order some guilt-free treats.`;
---

<section id="order-now" class="py-24 bg-white">
  <div class="container mx-auto px-6 md:px-20">
    <div
      class="bg-dark rounded-[3rem] p-12 md:p-24 text-center relative overflow-hidden shadow-2xl fade-up"
    >
      <!-- Background Decorative Elements -->
      <div
        class="absolute -top-24 -left-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10">
        <h2
          class="text-4xl md:text-7xl font-extrabold text-white mb-8 tracking-tight leading-tight"
        >
          Ready to Taste <span class="text-primary">Health?</span>
        </h2>
        <p
          class="text-xl md:text-2xl text-white/80 mb-12 max-w-2xl mx-auto leading-relaxed"
        >
          Join our community of wholesome eaters. Order your favorite guilt-free
          treats directly on WhatsApp and have them delivered to your doorstep.
        </p>

        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-4 bg-primary text-white text-xl md:text-3xl font-extrabold px-10 md:px-16 py-6 md:py-8 rounded-4xl hover:scale-105 transition-all shadow-[0_0_50px_rgba(235,94,40,0.3)] hover:shadow-[0_0_70px_rgba(235,94,40,0.5)] active:scale-95 group"
        >
          <MessageCircle
            size={48}
            strokeWidth={2.5}
            class="group-hover:rotate-12 transition-transform"
          />
          <span>Order on WhatsApp</span>
        </a>

        <p class="mt-8 text-white/40 text-sm font-medium">
          Typically responds within minutes
        </p>
      </div>
    </div>
  </div>
</section>
