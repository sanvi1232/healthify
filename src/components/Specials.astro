---
import { ArrowLeft, ArrowRight } from "lucide-astro";
import AntinUnde from "../assets/specials/antin-unde.png";
import Thalipeeth from "../assets/specials/talipeeth.png";

const specials = [
  {
    name: "Antin Unde",
    image: AntinUnde
  },
  {
    name: "Multigrain Thalipeeth",
    image: Thalipeeth
  },
  {
    name: "Cold Pressed Oil",
  },
  {
    name: "Jaggery Powder",
  },
  {
    name: "Millet Noodles",
  },
];
---

<section id="specials" class="bg-grey py-20 overflow-hidden">
  <div class="container mx-auto px-6 md:px-20">
    <h2 class="text-4xl md:text-6xl font-extrabold text-white mb-4 tracking-tight fade-up">
      The "Guilt-Free" Specials
    </h2>
    
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-12 fade-up" style="transition-delay: 100ms">
      <h3 class="text-xl md:text-3xl font-semibold text-white">
        Our Best Sellers - Now Up to 40% Off
      </h3>
      
      <div class="hidden md:flex gap-4 mt-6 md:mt-0">
        <button 
          id="specials-scroll-left" 
          class="w-14 h-14 rounded-full bg-dark flex items-center justify-center text-white hover:bg-opacity-80 transition hover:-translate-x-1"
          aria-label="Scroll left"
        >
          <ArrowLeft size={24} />
        </button>
        <button 
          id="specials-scroll-right" 
          class="w-14 h-14 rounded-full bg-dark flex items-center justify-center text-white hover:bg-opacity-80 transition hover:translate-x-1"
          aria-label="Scroll right"
        >
          <ArrowRight size={24} />
        </button>
      </div>
    </div>

    <!-- Cards Container -->
    <div 
      id="specials-container" 
      class="flex gap-6 md:gap-8 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-8 fade-up"
      style="transition-delay: 200ms"
    >
      {
        specials.map((item) => (
          <div class="min-w-[85vw] md:min-w-[400px] h-[480px] md:h-[500px] bg-dark rounded-[2.5rem] flex flex-col justify-end p-8 relative snap-center shadow-lg transition-transform hover:scale-[1.02]">
            <div class="absolute inset-0 p-6 top-0 rounded-[2.5rem] bg-dark w-full h-full flex items-center justify-center pointer-events-none overflow-hidden">
                <img src={item.image?.src} alt={item.name} class="w-full h-full object-cover" />
                <!-- Gradient Overlay -->
                <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent"></div>
            </div>
            
            <!-- Bottom Content -->
            <div class="flex justify-between items-end w-full relative z-10 gap-4">
              <h4 class="text-white text-2xl md:text-3xl font-bold leading-tight max-w-[60%]">
                {item.name}
              </h4>
              <a 
                href="#order" 
                class="bg-primary text-white font-bold py-3 px-6 rounded-xl hover:bg-opacity-90 transition-all shadow-md shrink-0 text-sm md:text-base"
              >
                Order now
              </a>
            </div>
          </div>
        ))
      }
    </div>
    
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('specials-container');
    const scrollLeftBtn = document.getElementById('specials-scroll-left');
    const scrollRightBtn = document.getElementById('specials-scroll-right');

    if (!container || !scrollLeftBtn || !scrollRightBtn) return;

    // Scroll amount is roughly one card width + gap
    const getScrollAmount = () => {
      const card = container.children[0] as HTMLElement;
      if (!card) return 400;
      return card.offsetWidth + 32; // 32px is roughly the 2rem gap
    };

    scrollLeftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  });
</script>
